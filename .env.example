# Copy this file to .env and fill in the key. Never commit .env.

# Google Maps Platform key with "Solar API" enabled (console.cloud.google.com)
GOOGLE_MAPS_API_KEY=

# Optional. Identifies your app to OpenStreetMap Nominatim (its usage policy asks for it):
# SOLARY_USER_AGENT=my-app/1.0 (contact@example.com)

# Optional. Cache folder (default: ./data) and origins of a frontend served from elsewhere:
# SOLARY_DATA=data
# SOLARY_CORS_ORIGINS=http://localhost:5173
